rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mahallenin Mutfağı: Tüm veritabanı erişimi güvenli Node.js backend (Firebase Admin SDK)
    // üzerinden yapılmaktadır. İstemcilerin doğrudan veritabanına erişimi güvenlik gereği kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
